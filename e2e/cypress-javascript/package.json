{
  "name": "cypress-javascript-e2e",
  "version": "1.0.0",
  "scripts": {
    "test": "npm run test:e2e && npm run test:accessibility && npm run test:uat",
    "cy:run": "rm -rf allure-results && npm run cy:run:desktop && npm run cy:run:mobile && node scripts/merge-allure-results.js allure-results allure-results/.device-desktop allure-results/.device-mobile",
    "cy:run:desktop": "bash -c 'CYPRESS_SUITE=${CYPRESS_SUITE:-e2e} CYPRESS_DEVICE=desktop ALLURE_RESULTS_DIR=allure-results/.device-desktop cypress run --browser chrome'",
    "cy:run:mobile": "bash -c 'CYPRESS_SUITE=${CYPRESS_SUITE:-e2e} CYPRESS_DEVICE=mobile ALLURE_RESULTS_DIR=allure-results/.device-mobile cypress run --browser chrome'",
    "test:e2e": "CYPRESS_SUITE=e2e npm run cy:run",
    "test:e2e:parallel": "bash scripts/run-cypress-parallel.sh e2e",
    "test:e2e:serial": "npm run test:e2e",
    "test:mock": "npm run test:e2e",
    "test:accessibility": "CYPRESS_SUITE=accessibility npm run cy:run",
    "test:accessibility:parallel": "bash scripts/run-cypress-parallel.sh accessibility",
    "test:accessibility:serial": "npm run test:accessibility",
    "test:uat": "CYPRESS_SUITE=uat npm run cy:run",
    "test:open": "CYPRESS_SUITE=all cypress open",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "undici": "6.28.0",
    "fast-uri": "3.1.6",
    "browserslist": "4.28.7",
    "brace-expansion": "5.0.9",
    "postcss": "8.5.23",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "axios": "^1.7.2",
    "cypress": "^15.16.0",
    "cypress-axe": "^1.6.0",
    "cypress-split": "^1.24.25",
    "dotenv": "^16.4.5"
  }
}
